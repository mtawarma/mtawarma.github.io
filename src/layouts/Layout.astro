---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	pagetype: string;
}

const {title, description, pagetype} = Astro.props;
const base:string = String(import.meta.env.BASE_URL);
/* canonical links must be ABSOLUTE urls (Lighthouse/Google: "not a valid
   rel=canonical -- is not an absolute URL"). BASE_URL is "/" (the config's
   base), so the absolute form comes from Astro.site (the config's `site`). */
const origin:string = String(Astro.site);

const canonical: Record<string, string> = {
  home: origin,
  resume: `${origin}cv/`,
  appointments: `${origin}appointments/`,
  books: `${origin}books/`,
  publications: `${origin}journals/`,
  conferences: `${origin}conferences/`,
  honors: `${origin}honors/`,
  students: `${origin}phdstudents/`,
  teaching: `${origin}teaching/`,
  contact: `${origin}contact/`,
  search: `${origin}searchsite/`,
};

const navItems = [
  { type: "home", label: "Home", href: base },
  { type: "resume", label: "Resume", href: `${base}cv/` },
  { type: "appointments", label: "Appointments", href: `${base}appointments/` },
  { type: "books", label: "Book", href: `${base}books/` },
  { type: "publications", label: "Publications", href: `${base}journals/` },
  { type: "conferences", label: "Conferences", href: `${base}conferences/` },
  { type: "honors", label: "Honors", href: `${base}honors/` },
  { type: "students", label: "PhD Students", href: `${base}phdstudents/` },
  { type: "teaching", label: "Teaching", href: `${base}teaching/` },
  { type: "contact", label: "Contact", href: `${base}contact/` },
  { type: "search", label: "Search", href: `${base}searchsite/` },
];
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<script is:inline>
	/* www.mohit.prof is the canonical domain (the CNAME, the canonical
	   links, the sitemap). The display name stays "mohit.prof" (easier to
	   remember); if we happen to be served from the apex, bounce to www,
	   preserving the path and query. */
	if (location.hostname === "mohit.prof") {
		location.replace("https://www.mohit.prof" + location.pathname + location.search);
	}
	</script>
	<meta name="description" content={description} />
	<meta name="viewport" content="width=device-width" />
	<title>{title}</title>
	{canonical[pagetype] && <link rel="canonical" href={canonical[pagetype]} />}
	<link rel="apple-touch-icon" href={`${base}apple-touch-icon-precomposed.png`}>
	<link rel="icon" sizes="16x16" href={`${base}favicon_16x16.ico`}>
	<link rel="icon" type="image/x-icon" sizes="32x32" href={`${base}favicon.ico`}>
	{!["home", "honors", "contact"].includes(pagetype) &&
		<link rel="preload" href={`${base}fonts/o-0ZIpQlx3QUlC5A4PNr4C5OaxRsfNNlKbCePevtuXOmHS91iw.woff2`} crossorigin="anonymous" as="font">}
	<link rel="preload" href={`${base}fonts/o-0bIpQlx3QUlC5A4PNB6Ryti20_6n1iPHjc5a7du3mhPy0.woff2`} crossorigin as="font">
	<link rel="sitemap" href="/sitemap-index.xml" />
	<script is:inline>
	 function playAudio() {
     const y = document.getElementById('pronounce');
     const url = y.dataset.url;
     new Audio(url).play();
  }
	</script>
	<script is:inline type="module">
     /* the highlighter only acts on a ?highlight= param (search navigation) --
        importing it unconditionally put a 9.7 KiB request on every page's
        critical chain (Lighthouse: "avoid chaining critical requests").
        On-demand: fetched only on the loads that actually use it. */
     if (new URLSearchParams(location.search).has("highlight")) {
       await import('/pagefind/pagefind-highlight.js');
       new PagefindHighlight({ highlightParam: "highlight" });
     }
	</script>
</head>

<body>
  <div class="drawer lg:drawer-open">
    <input id="my-drawer-2" type="checkbox" class="drawer-toggle" aria-labelledby="drawer-title"/>
    <div class="drawer-content">
          <slot />
    </div>
    <div class="flex-none lg:hidden justify-left">
          <label for='my-drawer-2' class="btn btn-square drawer-button btn-ghost swap z-30">
          <span class="sr-only" id="drawer-title">Open navigation menu</span>
<svg class="swap-off fill-base-content" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 512 512"><path d="M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z"/></svg>        
      <!-- close icon -->
      <svg class="swap-on fill-base-content" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 512 512"><polygon points="400 145.49 366.51 112 256 222.51 145.49 112 112 145.49 222.51 256 112 366.51 145.49 400 256 289.49 366.51 400 400 366.51 289.49 256 400 145.49"/></svg> 
        </label>
    </div>
    <div class="drawer-side">
      <div 
         class="drawer-overlay" 
         aria-hidden="true" 
         onclick="document.getElementById('my-drawer-2').checked = false">
      </div>
        <div class="min-h-full">
          <div class="h-10 w-56 bg-base-100">
          </div>
        <div class="menulist border-r-2 border-base-content/100 bg-base-100">
          <ul class="menu text-2xl w-56 p-4 [&_li>*]:rounded-none">
            {navItems.map((item) => (
              <li>
                <a class:list={["menuitem", item.type === pagetype ? "myactive" : "navlink"]} href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="h-10 w-56 bg-base-100">
        </div>
        </div>
    </div>
  </div>

</body>
</html>
<style is:global>
@reference "../styles/global.css";

        /* The drawer's toggle checkbox is nested in a <label>, so DaisyUI's own
           `.swap input:checked~.swap-on` rule can never match it. Swap the
           hamburger/X icons manually when the drawer is open. */
        #my-drawer-2:checked ~ .flex-none .swap-off {
          opacity: 0;
        }
        #my-drawer-2:checked ~ .flex-none .swap-on {
          opacity: 1;
        }

        /* Menu links stay base-content (near black), not the site-wide link
           colors: global.css' `a{link-accent...visited:link-secondary}` compiles
           into @layer daisyui.l1.l2, which beats the .menu component color
           (layer components). This rule is unlayered, so it wins over both --
           the menu keeps its black typesetting (visited included) while the
           page content links stay accent/primary/secondary. The :hover and
           .myactive rules below are also unlayered with equal-or-greater
           specificity and later source order, so they still win over this. */
        a.menuitem, a.menuitem:visited {
             @apply text-base-content;
        }
        li.menuitem > :active {
             @apply bg-base-100;
        }
        a.menuitem.navlink:hover, a.menuitem.navlink:active {
             @apply text-primary;
             @apply bg-base-100;
        }
        a.menuitem.myactive, a.menuitem.myactive:hover {
             @apply bg-neutral;
             @apply text-neutral-content;
        }
        /* In the default daisyUI dark theme, --color-neutral (oklch 14%) is
           barely distinguishable from --color-base-100 (oklch 25%), so the
           active item was a slightly-darker box on a dark menu -- the
           inversion is invisible (user: "the dark mode is automatically
           loaded depending on browser preference" -- the HTML carries no
           data-theme attribute and no theme radio, so the media query
           scopes the dark theme exactly). Dark-mode inversion: a light
           box with dark text. This rule is later in source order with
           equal specificity, so it wins whenever the media matches. */
        @media (prefers-color-scheme: dark) {
          a.menuitem.myactive, a.menuitem.myactive:hover {
               @apply bg-base-content;
               @apply text-base-100;
          }
        }
        .menulist {
             min-height: calc(100vh - 5rem);
        }
</style>
