---
import "@pagefind/default-ui/css/ui.css";

export interface Props {
  readonly id?: string;
  readonly className?: string;
  readonly query?: string;
  readonly uiOptions?: Record<string, any>;
}

const { id, className, query, uiOptions = {} } = Astro.props;
const bundlePath = `${import.meta.env.BASE_URL}pagefind/`;
---

<div
  id={id}
  class:list={[className, "pagefind-init"]}
  data-pagefind-ui
  data-bundle-path={bundlePath}
  data-query={query}
  data-ui-options={JSON.stringify(uiOptions)}
>
</div>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  // Pagefind emits one `highlight` param per matched sub-result; the Pagefind
  // highlighter only reads a single param, so merge duplicates into one value.
  const mergeHighlightParams = (url) => {
    if (!url) return url;
    const u = new URL(url, window.location.origin);
    const highlights = u.searchParams.getAll("highlight");
    if (highlights.length < 2) return url;
    u.searchParams.delete("highlight");
    u.searchParams.set("highlight", highlights.join(" "));
    return u.pathname + u.search + u.hash;
  };

  function initPageFind() {
    for (const el of document.querySelectorAll("[data-pagefind-ui].pagefind-init")) {
      const selector = el.id ? `#${el.id}` : `.${el.classList.value.split(" ")[0]}`;
      const opts = JSON.parse(el.getAttribute("data-ui-options") ?? "{}");

      new PagefindUI({
        ...opts,
        element: selector,
        showSubResults: true,
        highlightParam: "highlight",
        bundlePath: el.getAttribute("data-bundle-path"),
        processResult: (result) => {
          if (!result) return result;
          result.url = mergeHighlightParams(result.url);
          for (const sub of result.sub_results ?? []) {
            sub.url = mergeHighlightParams(sub.url);
          }
          return result;
        },
      });

      el.classList.remove("pagefind-init");

      const query = el.getAttribute("data-query");
      if (query) {
        const input = el.querySelector('input[type="text"]');
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }
  }

  // Module scripts run after the DOM is parsed, so a single call is enough.
  initPageFind();
</script>
