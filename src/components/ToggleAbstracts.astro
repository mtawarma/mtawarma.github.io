---
// Two stateful page-level buttons shared by the publications pages (journals,
// conferences): "Abstracts" and "BibTeX".
//
// State is NOT stored separately -- it is *derived* from the first disclosure
// block of that type on the page (the first div.abstract-body / first
// div.bibtex in DOM order). The first item governs the button, so it can never
// disagree with the page: toggle the first paper's link and the top button
// follows (this script notices via a delegated click listener). Clicking a
// button sets ALL blocks of that type to the opposite of the first block's
// state -- one click brings the page to a uniform state, both directions
// reachable from any state.
//
// NOTE: is:inline scripts share the global page scope -- IIFE-wrapped so the
// helper name cannot collide with BibtexCopy.astro's script.
// ADA: aria-pressed carries the state (screen readers announce "pressed" /
// "not pressed"); aria-label describes the purpose; title is the tooltip.
// Size: the inline style puts the buttons on the same --disclosure-size knob
// as the per-paper disclosure text (the buttons sit inside .myinclude, where
// the variable is declared).
//
// Look: they work like menu items (user: "they work like menu .. except
// they appear as clicked when the first abstract or bibtex is open") --
// the text color at rest, the theme's hover color on hover, and the
// menu's active-item inversion as the pressed state (a dark box with
// light text in the light theme, a light box with dark text in the dark
// one -- the same media-scoped inversion Layout.astro uses for the active
// menu item).
---
<button class="bulkbtn mr-8" id="absToggleBtn" aria-pressed="false"
  aria-label="Toggle the abstracts of all papers on this page"
  title="Show or hide all abstracts" style="font-size: var(--disclosure-size); font-weight: 400">Abstracts</button>
<button class="bulkbtn" id="bibToggleBtn" aria-pressed="false"
  aria-label="Toggle the BibTeX entries of all papers on this page"
  title="Show or hide all BibTeX entries" style="font-size: var(--disclosure-size); font-weight: 400">BibTeX</button>

<style>
  @reference "../styles/global.css";
  /* work like a menu item (see the header note): text color at rest,
     the theme's hover color (the site's primary: red in light, gold in
     dark) on hover, and the menu's active-item inversion as the pressed
     state (the old 3px accent ring is gone). The state is read from the
     aria-pressed attribute the script derives from the DOM, so CSS and
     JS can never disagree. The pressed rule comes after :hover in source
     order, so a pressed button keeps its inversion while hovered (like
     the active menu item). */
  .bulkbtn {
    @apply px-2 py-1 border-0 bg-transparent text-base-content cursor-pointer;
  }
  .bulkbtn:hover {
    @apply text-primary;
  }
  .bulkbtn[aria-pressed="true"] {
    @apply bg-neutral text-neutral-content;
  }
  @media (prefers-color-scheme: dark) {
    .bulkbtn[aria-pressed="true"] {
      @apply bg-base-content text-base-100;
    }
  }
  /* ADA: visible keyboard focus (WCAG 2.4.7) -- the same outline the
     per-paper disclosure buttons get (cvstyle.scss) */
  .bulkbtn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script is:inline>
  (function () {
    function sync(btnId, blockSel) {
      var first = document.querySelector(blockSel);
      document.getElementById(btnId).setAttribute(
        "aria-pressed", String(!!first && !first.hasAttribute("hidden")));
    }
    function flip(btnId, blockSel) {
      var first = document.querySelector(blockSel);
      if (!first) return;
      var show = first.hasAttribute("hidden");
      document.querySelectorAll(blockSel).forEach(function (el) {
        if (show) el.removeAttribute("hidden");
        else el.setAttribute("hidden", "");
      });
      sync(btnId, blockSel);
    }
    document.getElementById("absToggleBtn").addEventListener("click", function () { flip("absToggleBtn", ".abstract-body"); });
    document.getElementById("bibToggleBtn").addEventListener("click", function () { flip("bibToggleBtn", "div.bibtex"); });
    // Per-paper toggles (BibtexCopy.astro): re-derive the button state when
    // one is used. Their handlers run in the target phase, before this
    // document-level (bubble) listener, so the hidden attribute is already
    // updated by the time we read it.
    document.addEventListener("click", function (e) {
      if (e.target.closest("button.abs-toggle")) sync("absToggleBtn", ".abstract-body");
      else if (e.target.closest("button.bib-toggle")) sync("bibToggleBtn", "div.bibtex");
    });
    // The script sits above the mdx content, so the blocks are not parsed yet
    // at run time; re-derive on load so the initial state matches whatever
    // the generator emitted (all hidden today).
    document.addEventListener("DOMContentLoaded", function () {
      sync("absToggleBtn", ".abstract-body");
      sync("bibToggleBtn", "div.bibtex");
    });
  })();
</script>
