---
// Buttons + script shared by the publications pages (journals, conferences)
---
<button class="btn mr-8" id="showBtn">Show abstracts</button>
<button class="btn" id="hideBtn">Hide abstracts</button>

<script is:inline>
  const setAbstracts = (open) => {
    for (const el of document.getElementsByTagName("details")) {
      el.open = open;
    }
  };
  document.getElementById("showBtn").addEventListener("click", () => setAbstracts(true));
  document.getElementById("hideBtn").addEventListener("click", () => setAbstracts(false));
</script>
