    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.6.1",
    "@astrojs/svelte": "^8.0.0",
    "@tailwindcss/vite": "^4.0.15",
    "@types/katex": "^0.16.7",
    "astro": "^7.1.6",
    "astro-pagefind": "^1.8.3",
    "katex": "^0.16.21",
    "svelte": "^5.25.2",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "daisyui": "^5.0.9",
    "sass-embedded": "^1.86.0"
  },
  "overrides": {
